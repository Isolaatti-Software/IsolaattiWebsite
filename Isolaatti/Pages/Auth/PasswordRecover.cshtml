@page
@model Isolaatti.Pages.Auth.PasswordRecover

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recover Password - Isolaatti</title>
    <link rel="stylesheet" href="~/css/login.css">
</head>
<body>
<div class="login-container">
    <div class="login-card">
        <h2>Recover Password</h2>
        <form id="recoverForm" method="post">
            <div class="form-group">
                <label for="email">Email Address</label>
                <input type="email" id="email" required asp-for="Email">
            </div>
            <div class="actions">
                <button type="submit" id="recoverBtn">Recover Password</button>
                <button type="button" class="btn-secondary" onclick="window.location.href='/login'">Back to Sign In</button>
            </div>
        </form>
    </div>
    <div class="app-name">Isolaatti</div>
</div>
</body>
</html>