@page "/login"
@model Isolaatti.Pages.Auth.LoginPage

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Isolaatti</title>
    <link rel="stylesheet" href="~/css/login.css">
</head>
<body>
<div class="login-container">
    <div class="login-card">
        <h2>Sign In</h2>
        <form id="loginForm" method="post">
            @if (Model.IncorrectLogin)
            {
                <div style="color: #d93025; background-color: #fce8e6; padding: 0.8rem; border-radius: 6px; margin-bottom: 1.25rem; font-size: 0.9rem; text-align: center; border: 1px solid #f5c2c7;">
                    Invalid username or password.
                </div>
            }
            <div class="form-group">
                <label for="username">Username</label>
                <input type="text" id="username" required asp-for="Username">
            </div>
            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" required asp-for="Password">
            </div>
            <div class="checkbox-group">
                <input type="checkbox" id="rememberMe" asp-for="RememberMe">
                <label for="rememberMe">Remember Me</label>
            </div>
            <div class="actions">
                <button type="submit" id="signInBtn">Sign In</button>
                <a asp-page="PasswordRecover" id="forgotPasswordBtn" class="action" style="text-align: center;">Forgot Password</a>
                <div style="border-top: 1px solid #dddfe2; margin: 0.5rem 0;"></div>
                <a asp-page="SignUp" class="btn btn-secondary">Create Account</a>
            </div>
        </form>
    </div>
    <div class="app-name">Isolaatti</div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const loginForm = document.getElementById('loginForm');
        const forgotPasswordBtn = document.getElementById('forgotPasswordBtn');
        
        forgotPasswordBtn.addEventListener('click', function() {
            console.log('Forgot password clicked (logic not implemented)');
            // Future logic goes here
        });
    });
</script>
</body>
</html>