@page
@using Isolaatti.Resources.Pages
@using Microsoft.AspNetCore.Mvc.Localization
@model Isolaatti.Pages.WelcomePage

@{
    Layout = null;
}
@inject IViewLocalizer Localizer

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Localizer["welcome_message"]</title>
    
    <link rel="stylesheet" href="/css/isolaatti.css" />
    <style>
        .hero-section {
            padding: 4rem 0;
            background-color: #f8f9fa;
        }
        .feature-image {
            max-width: 100%;
            height: auto;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        footer {
            background-color: #343a40;
            color: white;
            padding: 2rem 0;
        }
        footer a {
            color: #adb5bd;
            margin: 0 10px;
        }
        footer a:hover {
            color: white;
            text-decoration: none;
        }
    </style>
</head>
<body class="d-flex flex-column" style="min-height: 100vh;">

    <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
        <div class="container">
            <a class="navbar-brand font-weight-bold" href="#">Isolaatti</a>
            <div class="ml-auto">
                <a asp-page="/SignIn" class="btn btn-outline-primary mr-2">Sign In</a>
                <a asp-page="/SignUp" class="btn btn-primary">Sign Up</a>
            </div>
        </div>
    </nav>

    <main class="flex-shrink-0">
        <section class="hero-section text-center">
            <div class="container">
                <h1 class="display-4">@Localizer["welcome_message"]</h1>
                <p class="lead text-muted">A social platform built for meaningful connections and shared experiences.</p>
                <div class="mt-4">
                    <img src="https://via.placeholder.com/800x400" alt="Isolaatti Platform Preview" class="hero-image img-fluid rounded shadow" />
                </div>
            </div>
        </section>

        <section class="py-5">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <h2>Connect with others</h2>
                        <p>Isolaatti allows you to stay in touch with your friends and discover new people who share your interests.</p>
                        <p>Whether it's sharing updates, photos, or participating in discussions, Isolaatti provides the tools you need to build your community.</p>
                    </div>
                    <div class="col-md-6">
                        <img src="https://via.placeholder.com/500x300" alt="Social Connection" class="feature-image" />
                    </div>
                </div>
            </div>
        </section>

        <section class="py-5 bg-light">
            <div class="container">
                <div class="row align-items-center flex-row-reverse">
                    <div class="col-md-6">
                        <h2>Safe and Private</h2>
                        <p>We value your privacy. Isolaatti is designed with security in mind, ensuring your data and conversations stay protected.</p>
                        <p>Customizable privacy settings allow you to control who sees your content and how you interact with others.</p>
                    </div>
                    <div class="col-md-6">
                        <img src="https://via.placeholder.com/500x300" alt="Privacy and Security" class="feature-image" />
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer class="mt-auto">
        <div class="container text-center">
            <div class="mb-3">
                <a href="#">About</a>
                <a href="#">Privacy Policy</a>
                <a href="#">Terms of Use</a>
                <a href="#">Help</a>
                <a href="#">Blog</a>
            </div>
            <p class="text-muted small mb-0">&copy; 2026 Isolaatti Software. All rights reserved.</p>
        </div>
    </footer>

</body>
</html>