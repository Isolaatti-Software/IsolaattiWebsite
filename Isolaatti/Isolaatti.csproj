<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Configurations>Debug;Release;release</Configurations>
        <Platforms>AnyCPU</Platforms>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <RootNamespace>Isolaatti</RootNamespace>
        <Company>Isolaatti Software</Company>
        <LangVersion>12</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>


    <ItemGroup>

        <PackageReference Include="Microsoft.AspNet.WebApi.Client" Version="6.0.0" />

        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.22" />

        <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.22" />
        <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="8.0.16" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="8.0.16" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.16" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.16">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
        <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.0" />
        <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="8.0.2" />
        <PackageReference Include="MongoDB.Driver" Version="2.24.0" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
        <PackageReference Include="RabbitMQ.Client" Version="6.8.1" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
        <PackageReference Include="System.Linq.Async" Version="6.0.1" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Accounts\SignIn\Controller\" />
        <Folder Include="Audios\Data\" />
        <Folder Include="Migrations" />
        <Folder Include="Squads\Policies\" />
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="Pages\Audaliv\Audaliv.cshtml" />
      <_ContentIncludedByDefault Remove="Pages\Audaliv\Index.cshtml" />
      <_ContentIncludedByDefault Remove="Pages\Likes\GivenLikes.cshtml" />
      <_ContentIncludedByDefault Remove="Pages\Likes\ReceivedLikes.cshtml" />
      <_ContentIncludedByDefault Remove="Pages\SquadsPages\ManageSquadAdmins.cshtml" />
      <_ContentIncludedByDefault Remove="Pages\SquadsPages\ManageSquadMembers.cshtml" />
      <_ContentIncludedByDefault Remove="Pages\SquadsPages\ManageSquadOwner.cshtml" />
      <_ContentIncludedByDefault Remove="Pages\SquadsPages\Squads.cshtml" />
      <_ContentIncludedByDefault Remove="Pages\SquadsPages\SquadViewer.cshtml" />
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="Pages\Audaliv\Audaliv.cshtml" />
      <_ContentIncludedByDefault Remove="Pages\Audaliv\Index.cshtml" />
      <_ContentIncludedByDefault Remove="Pages\Likes\GivenLikes.cshtml" />
      <_ContentIncludedByDefault Remove="Pages\Likes\ReceivedLikes.cshtml" />
    </ItemGroup>

    <ItemGroup>
      <Content Remove="Pages\Boot\Boot.cshtml" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Resources\Pages\WelcomePage.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>WelcomePage.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Resources\Pages\WelcomePage.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>WelcomePage.resx</DependentUpon>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Include="Pages\Auth\ConfirmAccount.cshtml" />
      <AdditionalFiles Include="Pages\Auth\ContinueAccountCreation.cshtml" />
      <AdditionalFiles Include="Pages\Auth\SignUp.cshtml" />
    </ItemGroup>
    
</Project>
